<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}{% endblock %} · Admin {{ APP_NOM_OF }}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <link rel="icon" type="image/png" href="{{ asset('images/favicon.png') }}">
    {{ importmap('admin') }}
</head>
<body class="adm">

{# Le gabarit de connexion remplace toute la coquille. #}
{% block coquille %}
    <div class="adm-coquille">

        <aside class="adm-barre">
            <a href="{{ path('app_admin_requete') }}" class="adm-barre__marque">
                <img src="{{ asset('images/logo-algorythme-formation-blanc.png') }}"
                     alt="{{ APP_NOM_OF }}" width="649" height="187">
                <span>Admin</span>
            </a>

            <nav class="adm-barre__nav" aria-label="Navigation de l'admin">
                <a href="{{ path('app_admin_requete') }}"
                   {{ app.current_route == 'app_admin_requete' ? 'aria-current="page"' }}>
                    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
                    </svg>
                    Requêtes
                </a>
            </nav>

            <div class="adm-barre__pied">
                <a href="{{ path('home') }}" class="adm-barre__site">
                    <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/>
                    </svg>
                    Voir le site
                </a>
                <div class="adm-barre__compte">
                    <span class="adm-barre__email">{{ app.user.userIdentifier }}</span>
                    <a href="{{ logout_path() }}">Se déconnecter</a>
                </div>
            </div>
        </aside>

        <main class="adm-principal">
            <header class="adm-entete">
                <div>
                    <h1>{% block titre_page %}{% endblock %}</h1>
                    {% block sous_titre %}{% endblock %}
                </div>
            </header>

            {% block contenu %}{% endblock %}
        </main>

    </div>
{% endblock %}

</body>
</html>
