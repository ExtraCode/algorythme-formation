{# Gabarit commun des emails transactionnels.
   Styles en ligne : les clients mail ignorent la plupart des feuilles externes. #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ sujet }}</title>
</head>
<body style="margin:0;padding:24px;background:#F5FBF9;font-family:Arial,Helvetica,sans-serif;color:#0D3A46;line-height:1.6;">
<table role="presentation" cellpadding="0" cellspacing="0" border="0"
       style="max-width:600px;margin:0 auto;background:#FFFFFF;border:1px solid #D5E4E1;border-radius:10px;">
    <tr>
        <td style="padding:24px 32px;background:#0D3A46;border-radius:10px 10px 0 0;">
            <span style="color:#F5FBF9;font-size:18px;font-weight:bold;">{{ APP_NOM_OF }}</span>
        </td>
    </tr>
    <tr>
        <td style="padding:32px;">
            <h1 style="margin:0 0 24px;font-size:20px;color:#0D3A46;">{{ sujet }}</h1>
            {% block contenu %}{% endblock %}
        </td>
    </tr>
    <tr>
        <td style="padding:16px 32px;border-top:1px solid #D5E4E1;font-size:12px;color:#2F5972;">
            {{ APP_NOM_OF }} · 422 Avenue de Verdun, 33700 Mérignac ·
            <a href="mailto:contact@algorythme-formation.fr" style="color:#177078;">contact@algorythme-formation.fr</a>
        </td>
    </tr>
</table>
</body>
</html>
