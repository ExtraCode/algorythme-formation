{% extends 'emails/_layout.html.twig' %}

{% block contenu %}

    <p style="margin:0 0 24px;">
        Une demande vient d'être envoyée depuis le formulaire de la page Contact du site.
    </p>

    <h2 style="margin:0 0 12px;font-size:16px;color:#0D3A46;">Contact</h2>
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width:100%;margin:0 0 24px;">
        <tr>
            <td style="padding:8px 0;border-bottom:1px solid #D5E4E1;color:#2F5972;">Nom</td>
            <td style="padding:8px 0;border-bottom:1px solid #D5E4E1;font-weight:bold;">{{ contact.nom }}</td>
        </tr>
        <tr>
            <td style="padding:8px 0;border-bottom:1px solid #D5E4E1;color:#2F5972;">Fonction</td>
            <td style="padding:8px 0;border-bottom:1px solid #D5E4E1;font-weight:bold;">{{ contact.poste }}</td>
        </tr>
        <tr>
            <td style="padding:8px 0;border-bottom:1px solid #D5E4E1;color:#2F5972;">Entreprise</td>
            <td style="padding:8px 0;border-bottom:1px solid #D5E4E1;font-weight:bold;">{{ contact.entreprise }}</td>
        </tr>
        <tr>
            <td style="padding:8px 0;border-bottom:1px solid #D5E4E1;color:#2F5972;">Courriel</td>
            <td style="padding:8px 0;border-bottom:1px solid #D5E4E1;font-weight:bold;">
                <a href="mailto:{{ contact.email }}" style="color:#177078;">{{ contact.email }}</a>
            </td>
        </tr>
        <tr>
            <td style="padding:8px 0;border-bottom:1px solid #D5E4E1;color:#2F5972;">Téléphone</td>
            <td style="padding:8px 0;border-bottom:1px solid #D5E4E1;font-weight:bold;">
                <a href="tel:{{ contact.tel|replace({' ': '', '.': '', '-': ''}) }}" style="color:#177078;">{{ contact.tel }}</a>
            </td>
        </tr>
    </table>

    <h2 style="margin:0 0 12px;font-size:16px;color:#0D3A46;">Besoin exprimé</h2>
    {% if contact.message %}
        <p style="margin:0;padding:12px 16px;border-left:3px solid #F3CD74;background:#F5FBF9;white-space:pre-line;">{{ contact.message }}</p>
    {% else %}
        <p style="margin:0;color:#2F5972;">Le visiteur n'a pas décrit son besoin.</p>
    {% endif %}

{% endblock %}
