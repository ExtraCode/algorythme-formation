{% extends 'base.html.twig' %}

{% block title %}Page introuvable - {{ APP_NOM_OF }}{% endblock %}

{% block meta_description %}{% endblock %}

{% block robots %}noindex, nofollow{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/pages/texte.scss') }}">
{% endblock %}

{% block body %}

    <div class="texte">

        <nav class="pg-crumbs af-container" aria-label="Fil d'ariane">
            <ol>
                <li><a href="{{ path('home') }}">Accueil</a></li>
                <li aria-current="page">Page introuvable</li>
            </ol>
        </nav>

        <section class="pg-head af-container">
            <h1>Cette page n'existe pas</h1>
            <p class="pg-lede">
                L'adresse est peut-être erronée, ou la page a été déplacée.
                Une formation retirée du catalogue disparaît aussi du site.
            </p>
        </section>

        <div class="af-container pg-texte">
            <div class="pg-issues">
                <a href="{{ path('app_formation') }}" class="af-btn af-btn--primary">Voir nos formations</a>
                <a href="{{ path('home') }}" class="af-btn af-btn--secondary">Retour à l'accueil</a>
                <a href="{{ path('app_contact') }}" class="af-btn af-btn--secondary">Nous contacter</a>
            </div>
        </div>

    </div>

{% endblock %}
