{% extends 'admin/base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block coquille %}
    <main class="adm-connexion">
        <div class="adm-connexion__carte">

            <div class="adm-connexion__marque">
                <img src="{{ asset('images/logo_algorythme_formation.png') }}" alt="{{ APP_NOM_OF }}">
                <span>Administration</span>
            </div>

            {% if app.user %}
                <p>Vous êtes connecté en tant que <strong>{{ app.user.userIdentifier }}</strong>.</p>
                <div class="adm-connexion__actions">
                    <a href="{{ path('app_admin_requete') }}" class="adm-bouton adm-bouton--principal">Vers l'admin</a>
                    <a href="{{ logout_path() }}" class="adm-bouton adm-bouton--discret">Se déconnecter</a>
                </div>
            {% else %}
                <h1>Connexion</h1>

                {% if error %}
                    <p class="adm-alerte" role="alert">
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </p>
                {% endif %}

                <form method="post" action="{{ path('app_login') }}" class="adm-form" data-turbo="false">
                    <div class="adm-champ">
                        <label for="username">Email</label>
                        <input type="email" name="_username" id="username" value="{{ last_username }}"
                               autocomplete="email" required autofocus>
                    </div>

                    <div class="adm-champ">
                        <label for="password">Mot de passe</label>
                        <input type="password" name="_password" id="password"
                               autocomplete="current-password" required>
                    </div>

                    {# Jeton CSRF sans session : le contrôleur csrf-protection le
                       remplace et pose le cookie au moment de l'envoi. #}
                    <input type="hidden" name="_csrf_token"
                           value="{{ csrf_token('authenticate') }}"
                           data-controller="csrf-protection">

                    <button type="submit" class="adm-bouton adm-bouton--principal adm-bouton--large">
                        Se connecter
                    </button>
                </form>
            {% endif %}

        </div>

        <a href="{{ path('home') }}" class="adm-connexion__retour">← Retour au site</a>
    </main>
{% endblock %}
