                                <li><a class="active" data-bs-toggle="tab" href="#resume">Résumé</a></li>
                                <li><a data-bs-toggle="tab" href="#contenu">Programme</a></li>
                                {% if(formation.avisFormations is defined) %}
                                    <li><a data-bs-toggle="tab" href="#reviews">Appréciations</a></li>
                                {% endif %}
                            </ul>
                        </div>

                        <div class="tab-content">

                            <!-- Résumé -->
                            <div id="resume" class="tab-pane fade show active">

                                <ul class="nice-ul-box resume d-flex flex-wrap justify-content-between">

                                    <!-- Public de la formation Start -->
                                    <li class="resume__bloc mt-3">
                                        <div class="section-header">
                                            <div class="resume__bloc__titre section-left">
                                                <h2 class="title mb-0">Pour qui ?</h2>
                                            </div>
                                        </div>
                                        {{ formation.description.publicVise | nl2br }}
                                    </li>
                                    <!-- Public de la formation Start -->

                                    <!-- Prérequis de la formation Start -->
                                    <li class="resume__bloc mt-3">
                                        <div class="section-header">
                                            <div class="resume__bloc__titre section-left">
                                                <h2 class="title mb-0">Prérequis</h2>
                                            </div>
                                        </div>
                                        {{ formation.description.preRequis | nl2br }}
                                    </li>
                                    <!-- Prérequis de la formation End -->

                                    <!-- Objectifs de la formation Start -->
                                    <li class="resume__bloc w-100 mt-3">
                                        <div class="section-header">
                                            <div class="resume__bloc__titre section-left">
                                                <h2 class="title mb-0">Objectifs pédagogiques</h2>
                                            </div>
                                        </div>
                                        {{ formation.description.objectifsDeLaFormation | nl2br }}
                                    </li>
                                    <!-- Objectifs de la formation End -->

                                </ul>

                                <!-- Description de la formation Start -->
                                <h2 class="title mt-5">Description de la formation</h2>
                                <p class="text-justify">{{ formation.description.contenuDeLaFormation | nl2br }}</p>
                                <!-- Description de la formation End -->

                            </div>
                            <!-- Résumé End -->

                            {# Contenu #}
                            <div id="contenu" class="tab-pane fade">
                                {{ formation.description.contenuDeLaFormation | nl2br }}
                            </div>
